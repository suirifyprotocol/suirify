# Core network + Move config

PORT=4000
SUI_NETWORK=testnet
SUI_GRPC=https://fullnode.testnet.sui.io:443
SUI_RPC=https://fullnode.testnet.sui.io:443

# Sui endpoints by network (keep the one you use uncommented)
# Mainnet
# SUI_GRPC=https://fullnode.mainnet.sui.io:443
# SUI_RPC=https://fullnode.mainnet.sui.io:443
# Testnet
# SUI_GRPC=https://fullnode.testnet.sui.io:443
# SUI_RPC=https://fullnode.testnet.sui.io:443
# Devnet
# SUI_GRPC=https://fullnode.devnet.sui.io:443
# SUI_RPC=https://fullnode.devnet.sui.io:443
# Localnet
# SUI_GRPC=http://127.0.0.1:9000
# SUI_RPC=http://127.0.0.1:9000

# Optional GraphQL endpoint(s)
# SUI_GRAPHQL=https://your-graphql-endpoint
# SUI_GRAPHQL_LIST=https://first-graphql-endpoint,https://second-graphql-endpoint

PACKAGE_ID=0x2a81ddb98779253bd431e4737caca7c29bcfa8ac8ed57eaddecaf6fc530226e2
ADMIN_CAP_ID=0xYOUR_ADMIN_CAP
PROTOCOL_CONFIG_ID=0xYOUR_PROTOCOL_CONFIG
ATTESTATION_REGISTRY_ID=0xYOUR_ATTESTATION_REGISTRY
JURISDICTION_POLICY_MAP={"Nigeria":"","Ghana":"","Kenya":""}
JURISDICTION_POLICY_ID=0xOPTIONAL_POLICY

# Signing + secrets
ADMIN_PRIVATE_KEY=suiprivkey1...
SECRET_PEPPER=replace-this-pepper
API_TOKEN_SECRET=replace-api-secret

# Enclave data
ENCLAVE_CONFIG_ID=0xCONFIG
ENCLAVE_OBJECT_ID=0xOBJECT

ENCLAVE_PROXY_HOST=127.0.0.1
ENCLAVE_PROXY_PORT=8000

# Networking / CORS
HOST=0.0.0.0
ALLOWED_ORIGINS=https://v1.enclave.api.devnet.suirify.com
ADMIN_API_KEY=generate-strong-key

# Optional feature flags
BYPASS_FACE_MATCH=false
REQUEST_BODY_LIMIT=25mb
